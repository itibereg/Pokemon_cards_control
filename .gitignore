# Python: arquivos gerados e ambientes locais
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Empacotamento e executáveis gerados (mantém arquivos .spec no Git)
build/
dist/
*.egg-info/
.eggs/
*.exe
*.msi

# Credenciais e configurações privadas
.env
.env.*
!.env.example
!.env.template
config.local.py
config_local.py
settings.local.json
secrets.json
secrets.*.json
*credentials*.json
*token*.json
*.pem
*.key

# Bancos locais: compras, vendas, clientes e estoque
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db3

# Pastas de dados e arquivos privados do aplicativo
/data/
/runtime/
/cache/
/caches/
/backups/
/backup/
/exports/
/exports_private/
/imports/
/dados_privados/
*.log
*.log.*
*_cache.json
flag.txt

# Arquivos reais de importação de compras criados para este projeto
compra_*.json
compras_*.json

# Planilhas, listas e exportações com dados reais
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.ods

# Cópias e arquivos temporários
*.bak
*.backup
*.tmp
*.temp
*.swp
*.swo
*~
~$*

# Editores e sistema operacional
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Não colocar senhas ou tokens diretamente nos arquivos Python.
# O .gitignore não remove arquivos que já foram adicionados ao Git.
# Código, README, requirements.txt e imagens de app/ui/flags/ continuam permitidos.
